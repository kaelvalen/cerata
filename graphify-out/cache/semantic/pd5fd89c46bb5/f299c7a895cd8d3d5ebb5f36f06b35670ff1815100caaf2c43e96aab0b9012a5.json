{"nodes": [{"id": "docs_stage1_plan", "label": "Stage 1 Plan and Results", "file_type": "document", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_plan_stage1_question", "label": "Stage 1 Question: Which Capacity Is Required In Which Regime", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stage 1 answers where capacity is needed and where it stops generalizing, not which model is best; a systematically measured loss of the modular machinery counts as a successful Stage 1."}, {"id": "docs_stage1_plan_one_variable_per_experiment", "label": "Rule: One Variable Per Experiment", "file_type": "rationale", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature cache, partition, class order, budget, protocol and memory quota stay fixed so the ladder comparison is trustworthy."}, {"id": "docs_stage1_plan_failing_rung_reported_not_tuned", "label": "Rule: A Failing Rung Is Reported, Not Tuned", "file_type": "rationale", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rescuing a level with per-level hyper-parameter search would destroy the ladder comparison; sensitivity studies are separate experiments."}, {"id": "docs_stage1_plan_complexity_ladder", "label": "S2 Complexity Ladder (L0-L4)", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_plan_l0_ncm", "label": "L0_ncm Nearest-Class-Mean Readout", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_plan_l1_ridge", "label": "L1_ridge Closed-Form Ridge Readout", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0 parameters, 0 optimizer steps, accumulated sufficient statistics (A is 769x769, ~2.9 MB); dominates every learned rung and wins 34/34 shift conditions."}, {"id": "docs_stage1_plan_l2a_shared_joint", "label": "L2a_shared_joint Shared Adapter (Joint Control)", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L82", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_plan_l2b_shared_seq", "label": "L2b_shared_seq Shared Sequential Adapter", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_plan_l3_per_task", "label": "L3_per_task Per-Task Expert Bank (Routed)", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L84", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_plan_l4_oracle", "label": "L4_oracle Oracle-Routed Expert Bank", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_plan_routing_tax", "label": "Routing Tax (L4 - L3)", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L104", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Largest single cost: 26.88 points on CIFAR-100/ViT; the quantity any allocation or rejection mechanism must recover."}, {"id": "docs_stage1_plan_isolation_not_capacity", "label": "Expert Bank Buys Isolation, Not Capacity", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "L2b->L3 is +14.58 while joint L2a beats both, so sharing under the sequential constraint is the failure mode and per-task isolation is the fix."}, {"id": "docs_stage1_plan_fwt_representation_probe", "label": "Corrected FWT Definition (Representation Ridge Probe)", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L135", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Masked next-task evaluation is structurally zero in growing-head Class-IL (-3.73% for every level); a ridge probe on the current representation minus the probe on raw features is comparable and discriminative."}, {"id": "docs_stage1_plan_native_widths", "label": "NATIVE_WIDTHS Backbone Width Fix", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L231", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Requesting output_dim=256 from ViT-B/16 inserted a collapsing 768->256 head (NCM 28% vs 70%); asking each architecture for its native width fixes it, guarded by the ViT row reproducing S2."}, {"id": "docs_stage1_plan_r_iso", "label": "R_iso Realised/Available Isolation Ratio", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L442", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(L3-L2b)/(L4-L2b); its denominator moves with L2b so a rise can come from the shared baseline degrading."}, {"id": "docs_stage1_plan_r_iso_ncm", "label": "R_iso_ncm Baseline-Free Realization Ratio", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L490", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "(L3-L0)/(L4-L0); L0 is budget-free so it isolates 'the expert bank improved' from 'the shared baseline degraded'."}, {"id": "docs_stage1_plan_s8_preregistration", "label": "S8 Budget Pre-Registration", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L424", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Written before S8 finished so expectations cannot be read back as findings; regimes reported separately rather than as one accuracy-per-byte curve."}, {"id": "docs_stage1_plan_hard_routing_outcome_taxonomy", "label": "Hard-Routing Outcome Taxonomy (A/B/C)", "file_type": "concept", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L513", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_plan_call_existing_entry_point", "label": "Lesson: Call Existing Entry Point, Don't Re-derive Loop", "file_type": "rationale", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L417", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "s4_datasets.py re-implemented the ladder loop and lost the spec.joint branch, making L2a identical to L2b; fourth instance of a copied path losing branching."}, {"id": "docs_measurement_contract", "label": "MEASUREMENT_CONTRACT.md", "file_type": "document", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_contract", "label": "ARCHITECTURE_CONTRACT.md", "file_type": "document", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_palmoe_v2_spec", "label": "v1/PALMOE_V2_SPEC.md", "file_type": "document", "source_file": "docs/STAGE1_PLAN.md", "source_location": "L5", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_router_ranking_prereg", "label": "ROU