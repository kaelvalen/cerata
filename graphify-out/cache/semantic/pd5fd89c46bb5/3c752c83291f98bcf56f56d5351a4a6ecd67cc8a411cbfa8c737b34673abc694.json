{"nodes": [{"id": "docs_v1_sunum", "label": "PAL-MoE sunum notlari (presentation notes)", "file_type": "document", "source_file": "docs/v1/SUNUM.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_sunum_palmoe_v1", "label": "PAL-MoE v1 (dynamic MoE for class-incremental CL)", "file_type": "concept", "source_file": "docs/v1/SUNUM.md", "source_location": "L7-L20", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No component is new alone; the contribution is the joint design of three mechanisms under bounded memory, measured with an equal-byte protocol. H5 refutation narrows the claim to fixed-budget capacity expansion plus prototype-anchored routing."}, {"id": "docs_v1_sunum_prototype_memory", "label": "Prototype memory (v_p, r_p, o_p, x_p, y_p, owner_expert)", "file_type": "concept", "source_file": "docs/v1/SUNUM.md", "source_location": "L100-L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Framed as a function-space memory anchoring past model behaviour, not a replay buffer."}, {"id": "docs_v1_sunum_prototype_anchored_routing", "label": "Prototype-anchored routing (owner distillation, inference anchoring, negative boundary)", "file_type": "concept", "source_file": "docs/v1/SUNUM.md", "source_location": "L81-L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_sunum_dynamic_expert_allocation", "label": "Dynamic expert allocation (trigger, validation gate, function-preserving expansion)", "file_type": "concept", "source_file": "docs/v1/SUNUM.md", "source_location": "L81-L85", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_sunum_hypotheses_h1_h6", "label": "Hypotheses H1-H6 status table", "file_type": "concept", "source_file": "docs/v1/SUNUM.md", "source_location": "L89-L98", "source_url": null, "captured_at": 