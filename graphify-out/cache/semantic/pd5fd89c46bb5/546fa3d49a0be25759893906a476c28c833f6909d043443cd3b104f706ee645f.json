{"nodes": [{"id": "docs_v1_readme_pal_moe_v1_published_record", "label": "PAL-MoE v1: the published record", "file_type": "document", "source_file": "docs/v1/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Historical record moved verbatim from repo README on 2026-09-26; superseded by STAGE1 results, diagnosis synthesis and v3 architecture."}, {"id": "docs_v1_readme_pal_moe", "label": "PAL-MoE (Prototype-Anchored Latent MoE)", "file_type": "concept", "source_file": "docs/v1/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dynamic MoE for class-incremental CL: spawn a new expert per task, prototype-anchored linear router selects experts, replay stores 128-d latents instead of raw images."}, {"id": "docs_v1_readme_expert_freezing_routing_protection", "label": "Expert Freezing and Routing Protection", "file_type": "rationale", "source_file": "docs/v1/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old experts locked after their task; only newest expert and routing row adapt. Full router freeze during calibration and null-space orthogonalization measured harmful."}, {"id": "docs_v1_readme_function_preserving_expansion", "label": "Function-Preserving Expansion", "file_type": "rationale", "source_file": "docs/v1/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New expert spawned when trigger S(x) detects shift, gated by validation gate."}, {"id": "docs_v1_readme_quantitative_trigger", "label": "Quantitative Trigger S(x)", "file_type": "rationale", "source_file": "docs/v1/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_readme_split_mnist_results", "label": "Split-MNIST 5-seed