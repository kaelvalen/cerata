{"nodes": [{"id": "docs_stage1_results", "label": "Stage 1 Results", "file_type": "document", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_e0_ceiling", "label": "E0 Ceiling Study", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Training-free NCM beats v1 PAL-MoE and iCaRL; adapter saturates at rank 8; oracle routing is worth 27 points, so selection not capacity binds."}, {"id": "docs_stage1_results_v1_palmoe", "label": "v1 PAL-MoE", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses 1.3x stored bytes and 20x parameters of iCaRL for 5.6 points less accuracy, triggering the programme reset."}, {"id": "docs_stage1_results_icarl", "label": "iCaRL Baseline", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_s3_backbone_generalization", "label": "S3 Backbone Generalization", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_s7_representation_transfer", "label": "S7 Representation Transfer (Few-Shot Probe)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L127", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adaptation is inert on the full split but costs up to 14.75 points at 1-shot; the per-task bank loses most, so isolation costs generality."}, {"id": "docs_stage1_results_s4_dataset_generalization", "label": "S4 Dataset Generalization", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L152", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_s5_protocol_axis", "label": "S5 Protocol Axis (Class-IL / Task-IL Factorial)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L190", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routing effect and class-masking effect are almost fully redundant (26.88 + 25.20 combine to 26.96): telling the task and restricting classes are the same reminder."}, {"id": "docs_stage1_results_s5b_domain_il", "label": "S5b Domain-IL (Rotated MNIST)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L278", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routing tax persists at +11.69 under fixed label space, so it is not purely a class-space artifact; router tracks whichever axis separates tasks."}, {"id": "docs_stage1_results_s6_order_sensitivity", "label": "S6 Order Sensitivity", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L377", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_s6b_designed_difficulty", "label": "S6b Designed Difficulty (Coherent vs Dispersed)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L459", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Designs the difficulty contrast because random permutations sampled none; tax nearly doubles (13.98 -> 26.63) with cross-task overlap."}, {"id": "docs_stage1_results_coherent_regime", "label": "Coherent Partition (Easy Routing)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L468", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_dispersed_regime", "label": "Dispersed Partition (Hard Routing)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L469", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_cross_task_similarity", "label": "Cross-Task Similarity (Drives Routing Tax)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L490", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_intra_task_similarity", "label": "Intra-Task Similarity (Drives Oracle)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L490", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_s8_budget", "label": "S8 Resource Budget Study", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L526", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "64x rank sweep leaves the tax flat in both regimes; prototypes per class (memory axis) is the only lever; mixing experts per sample is a pure cost."}, {"id": "docs_stage1_results_router_resolution", "label": "Router Resolution (Prototypes Per Class)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L593", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "16 prototypes per class lowers the tax by ~2.7 points in both regimes but leaves 11.24 / 23.93 residual."}, {"id": "docs_stage1_results_prototype_anchor", "label": "Prototype Anchor (lambda_func, _l_func)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L650", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Holds the representation in place so forgetting is a floor effect (exactly 0.00 in 56 cells); sequential damage appears as lost plasticity."}, {"id": "docs_stage1_results_s9_robustness", "label": "S9 Robustness (Corruption and Spurious Cue)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L700", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The capacity/routing decomposition survives 34 shift conditions; tax grows monotonically with corruption severity; shortcut damage lands in routing under dispersed and in representation under coherent."}, {"id": "docs_stage1_results_s10_scalability", "label": "S10 Scalability (Task/Expert Count)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L877", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tax grows with T entirely because the oracle improves while L3 stays flat: extra specialization capacity is stranded behind the router."}, {"id": "docs_stage1_results_ranking_not_selection", "label": "Routing Failure Is Ranking, Not Selection", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L962", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coverage(m) falls with T while selector headroom at fixed m is constant, so the loss is in which experts become candidates."}, {"id": "docs_stage1_results_coverage_at_m", "label": "coverage(m) / selection_gap(m) Metrics", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L953", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_s11_confirmatory", "label": "S11 Confirmatory Protocol (Six Seeds)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1024", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six seeds chosen because N=5 cannot reach p<0.05 with an exact sign test; paired by construction; all nine directional tests reject at the design floor 0.0312."}, {"id": "docs_stage1_results_westfall_young_max_statistic", "label": "Westfall-Young Max-Statistic Correction", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1046", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nine strongly correlated tests on the same seeds; Holm cannot reject anything at N=6 for arithmetic reasons, so a joint sign-flip max-statistic with two-sided Wilcoxon is used."}, {"id": "docs_stage1_results_tost_equivalence", "label": "TOST Equivalence Test (2.0-Point SESOI)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1056", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "H4 'capacity does not move the tax' is an equivalence claim; a directional test can only fail to reject, so a pre-registered SESOI with TOST is required."}, {"id": "docs_stage1_results_h4_capacity_no_tax_reduction", "label": "H4: Capacity Does Not Reduce the Tax", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1118", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_measurement_bugs", "label": "Twelve Measurement Bugs", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1377", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_stage1_results_capacity_routing_decomposition", "label": "Capacity vs Routing-Realization Decomposition", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1524", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stage 1's answer is a decomposition: capacity exists but is not the constraint; routing ranking is; resolution is the only partial lever; the closed-form readout wins."}, {"id": "docs_stage1_results_reranking_failure", "label": "Frozen-Space Reranking Failure (F5)", "file_type": "concept", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1226", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rejector prefers the router's wrong pick 64-67% of the time because both read the same z_s and their errors are correlated."}, {"id": "docs_v1_benchmark", "label": "v1/BENCHMARK.md", "file_type": "document", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "experiments_stage1_run_all", "label": "experiments/stage1/run_all.py", "file_type": "code", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L15", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "experiments_stage1_s3_check_vit_features", "label": "experiments/stage1/s3_check_vit_features.py", "file_type": "code", "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L1394", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_stage1_results_s8_budget", "target": "docs_stage1_plan_s8_preregistration", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L576", "weight": 1.0}, {"source": "docs_stage1_results", "target": "docs_measurement_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L6", "weight": 1.0}, {"source": "docs_stage1_results", "target": "docs_architecture_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/STAGE1_RESULTS.md", "source_location": "L7", "weight": 1.0}, {"source": "docs_stage1_results", "target": "docs_stage1_plan", "re