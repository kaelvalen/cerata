{"nodes": [{"id": "docs_v1_benchmark_benchmark_methodology", "label": "PAL-MoE Benchmark Methodology", "file_type": "document", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_benchmark_class_incremental_protocol", "label": "Class-Incremental Evaluation Protocol (Avg Acc, Forgetting, BWT)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No task-id oracle at test time; top-1 routing decides."}, {"id": "docs_v1_benchmark_shared_frozen_encoder", "label": "Shared Frozen Base Encoder", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All methods share the same frozen encoder to isolate continual-learning mechanisms; fact 9 shows freezing removes the recency funnel on CIFAR."}, {"id": "docs_v1_benchmark_feature_cache", "label": "Feature Cache (--feature_cache)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Precomputes frozen-encoder features; mathematically equivalent, 2.15x speedup; but makes baselines store features and disables hybrid raw store (fact 19)."}, {"id": "docs_v1_benchmark_prototype_memory", "label": "PrototypeMemory", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores v_p/r_p/o_p latent prototypes; cached matrices cut stability loss 10.13s to 0.13s."}, {"id": "docs_v1_benchmark_recency_funnel", "label": "Recency Funnel", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Newest expert's routing row captures every task's routing; old experts starve. On CIFAR root cause is representation drift, not router weakness (fact 9)."}, {"id": "docs_v1_benchmark_ood_negative_boundary_loss", "label": "OOD Negative-Boundary Loss", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Max-entropy on historical prototypes for newest expert; lifted pure 49.85 to 76.60 (fact 1); later neutral once distillation present (E5)."}, {"id": "docs_v1_benchmark_router_anchor_distillation", "label": "Prototype-Owner Router Distillation", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Router trained 300 steps to predict prototype owners from stored latents only; dominant mechanism (facts 11, 12); +25.4 acc in E5."}, {"id": "docs_v1_benchmark_prototype_anchored_inference_routing", "label": "Prototype-Anchored Inference Routing", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "g=(1-a*conf)g_router + a*conf*r_p with threshold-free conf=1-d1/d2 since absolute distances not comparable across feature spaces; cannot compensate for drift."}, {"id": "docs_v1_benchmark_joint_latent_calibration", "label": "Joint Latent Calibration", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Substitute for distillation at 5 epochs (fact 12) but not redundant at 15-epoch schedule."}, {"id": "docs_v1_benchmark_validation_gate", "label": "Validation Gate (absolute/relative)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gate policy ablation is a wash (fact 16); representation is the bottleneck."}, {"id": "docs_v1_benchmark_historical_routing_lock", "label": "Exact Historical-Routing Lock (zero weight decay)", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adam decoupled weight decay shrank locked router rows; moving router to zero-decay group makes lock exact; pure dropped 76.60 to 65.60, recovered via distillation, lambda_ood 0.5, proto_routing_alpha 0.5 (fact 15)."}, {"id": "docs_v1_benchmark_batchnorm_eval_fix", "label": "Frozen Encoder eval() / BatchNorm Drift Fix", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Baselines flipped frozen encoder BN back to train mode, understating them; earlier 14-point gap was artifact (fact 14)."}, {"id": "docs_v1_benchmark_owner_aware_merging", "label": "Owner-Aware Prototype Merging", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Auto threshold merged cross-task prototypes inheriting one owner; merging restricted to same owner (fact 13)."}, {"id": "docs_v1_benchmark_representation_bottleneck", "label": "Representation as Bottleneck (stronger frozen backbone lever)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frozen ImageNet ResNet-18 lifts CIFAR-100 pure 9.48 to 16.01; largest single lever (fact 17)."}, {"id": "docs_v1_benchmark_storage_semantics_fact19", "label": "Feature-Cached Storage Semantics (design fact 19)", "file_type": "rationale", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feature-cached runs store features (feature_dim*4+8 bytes), not raw images; hybrid raw store disabled."}, {"id": "docs_v1_benchmark_raw_equal_byte_sweep", "label": "Raw-Pipeline Equal-Byte Sweep (fact 20)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At 1 MiB PAL beats raw ER by 16 points with 3.4x less forgetting; claim is storage-format dependent trade-off, not dominance."}, {"id": "docs_v1_benchmark_vit_b16_promotion", "label": "Frozen ViT-B/16 Promotion (fact 18)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CIFAR-10 pure 91.74 beats iCaRL by 7.6 but PAL stores ~8x bytes; CIFAR-100 iCaRL wins 64.94 vs 59.34."}, {"id": "docs_v1_benchmark_design_facts", "label": "Measured Design Facts (1-22)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_benchmark_research_toolkit", "label": "Research Toolkit (opt-in knobs)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every mechanism defaults to published behaviour; shared expert, generative replay, NCM heads, energy OOD etc."}, {"id": "docs_v1_benchmark_shared_expert", "label": "Shared Generalist Expert", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Always-on pathway drifted into newest task without anchoring; helpful only for class-shared domain streams."}, {"id": "docs_v1_benchmark_buffer_sampling_policy", "label": "Replay Buffer Sampling (recency vs reservoir)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reservoir gains ~3 acc points for baselines in feature-cache protocol; small in raw sweep, so PAL lead not artefact (fact 22, AO10)."}, {"id": "docs_v1_benchmark_trainable_encoder_collapse", "label": "Trainable-Encoder Collapse (E8b)", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure collapses 37.81 to 9.97 without frozen encoder; method depends on frozen/anchored representation."}, {"id": "docs_v1_benchmark_der_plus_plus", "label": "DER++ baseline", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_benchmark_experience_replay", "label": "Experience Replay (ER) baseline", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_benchmark_icarl", "label": "iCaRL baseline", "file_type": "concept", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_v1_benchmark_mir", "label": "MIR baseline (Aljundi et al., 2019)", "file_type": "paper", "source_file": "docs/v1/BENCHMARK.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interference-based selection did not beat random replay (fa